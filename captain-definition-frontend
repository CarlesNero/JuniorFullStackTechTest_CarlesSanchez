{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:18-alpine as build",
    "WORKDIR /app",
    "COPY ./VolskwagenTTFrontend/package*.json ./",
    "RUN npm install",
    "COPY ./VolskwagenTTFrontend/ ./",
    "RUN npm run build",
    "FROM nginx:alpine",
    "COPY default.conf /etc/nginx/conf.d/default.conf",
    "COPY --from=build /app/dist /usr/share/nginx/html",
    "EXPOSE 80",
    "CMD [\"nginx\", \"-g\", \"daemon off;\"]"
  ]
}
